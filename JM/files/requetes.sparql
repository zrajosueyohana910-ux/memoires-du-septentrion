# =====================================================================
# requetes.sparql : MémoireS du Nord (5 requêtes, non testées)
# À exécuter UNE PAR UNE dans YASGUI (une requête par onglet),
# sur l'endpoint Fuseki local chargé avec archive.ttl.
# =====================================================================

PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>
PREFIX dcat:   <http://www.w3.org/ns/dcat#>
PREFIX schema: <https://schema.org/>
PREFIX mv:     <http://memoria-nord.cm/vocab#>
PREFIX lieu:   <http://memoria-nord.cm/id/lieu/>


# ---------------------------------------------------------------------
# QC1 : Quels contes sont associés à quel peuple, dans quelle langue
#       et collectés par qui ?
# Attendu : 1 ligne (Contes de Goggo Addi, Fulbe, Fulfulde, Baumgardt)
# ---------------------------------------------------------------------
SELECT ?conte ?peuple ?langue ?conteuse ?collectrice
WHERE {
  ?c a mv:RecueilDeContes ;
     skos:prefLabel ?conte ;
     mv:associeAuPeuple ?p ;
     dct:language ?l ;
     dct:creator ?cr ;
     dct:contributor ?co .
  ?p  skos:prefLabel ?peuple .
  ?l  skos:prefLabel ?langue .
  ?cr foaf:name ?conteuse .
  ?co foaf:name ?collectrice .
}


# ---------------------------------------------------------------------
# QC2 : Quels instruments sont joués lors de quels rituels ou fêtes,
#       et par quels peuples ?
# ⚠️ Renverra 0 ligne tant que les triplets mv:jouePendant et
#    mv:joueParPeuple ne sont pas ajoutés à archive.ttl (source manquante).
# ---------------------------------------------------------------------
SELECT ?instrument ?evenement ?peuple
WHERE {
  ?i a mv:Instrument ;
     skos:prefLabel ?instrument ;
     mv:jouePendant ?e .
  ?e skos:prefLabel ?evenement .
  OPTIONAL {
    ?i mv:joueParPeuple ?p .
    ?p skos:prefLabel ?peuple .
  }
}
ORDER BY ?instrument


# ---------------------------------------------------------------------
# QC3 : Quels sites patrimoniaux sont situés dans les Monts Mandara,
#       et à quelle période remontent-ils ?
# Attendu : Diy-Gid-Biy (XIIe-XVIIe) et Rhumsiki (période vide, d'où OPTIONAL)
# ---------------------------------------------------------------------
SELECT ?site ?siecleDebut ?siecleFin
WHERE {
  ?s a mv:Site ;
     skos:prefLabel ?site ;
     schema:containedInPlace lieu:monts-mandara .
  OPTIONAL {
    ?s mv:siecleDebut ?siecleDebut ;
       mv:siecleFin ?siecleFin .
  }
}
ORDER BY ?site


# ---------------------------------------------------------------------
# QC4 (FÉDÉRÉE) : Pour chaque entité alignée sur Wikidata, quels sont
#       le libellé et la description correspondants sur Wikidata ?
# ⚠️ Nécessite un accès Internet depuis Fuseki, et des Q-id vérifiés.
# Un libellé ou une description absente en français reste vide (OPTIONAL).
# ---------------------------------------------------------------------
SELECT ?entite ?cible ?libelleWikidata ?descriptionWikidata
WHERE {
  ?e (skos:exactMatch|skos:closeMatch|owl:sameAs) ?cible .
  FILTER(STRSTARTS(STR(?cible), "http://www.wikidata.org/entity/"))
  ?e skos:prefLabel ?entite .

  SERVICE <https://query.wikidata.org/sparql> {
    OPTIONAL {
      ?cible rdfs:label ?libelleWikidata .
      FILTER(LANG(?libelleWikidata) = "fr")
    }
    OPTIONAL {
      ?cible schema:description ?descriptionWikidata .
      FILTER(LANG(?descriptionWikidata) = "fr")
    }
  }
}
ORDER BY ?entite


# ---------------------------------------------------------------------
# QC5 (AGRÉGAT) : Combien d'entités par catégorie compte notre graphe ?
# Attendu : Lieu 4, Peuple 3, Site 3, Fête 3, Instrument 3, Langue 2,
#           Personne 2, Recueil de contes 1, Rituel 1, Jeu de données 1
#           (total 23, fiche du jeu de données comprise)
# Les libellés sont associés aux classes dans le VALUES : aucune classe
# sans libellé ne peut être mal étiquetée.
# ---------------------------------------------------------------------
SELECT ?categorie (COUNT(DISTINCT ?e) AS ?nombre)
WHERE {
  VALUES (?classe ?categorie) {
    (mv:Peuple          "Peuple")
    (mv:Langue          "Langue")
    (mv:Site            "Site")
    (mv:Lieu            "Lieu")
    (mv:RecueilDeContes "Recueil de contes")
    (mv:Rituel          "Rituel")
    (mv:Fete            "Fête")
    (mv:Instrument      "Instrument")
    (foaf:Person        "Personne")
    (dcat:Dataset       "Jeu de données")
  }
  ?e a ?classe .
}
GROUP BY ?categorie
ORDER BY DESC(?nombre)
