    dct:description "Village kapsiki emblématique."@fr ;
    dct:relation peuple:kapsiki ;
    skos:prefLabel "Rhumsiki"@fr ;
    schema:containedInPlace lieu:monts-mandara .

langue:psikye a mv:Langue ;
    skos:exactMatch wd:Q56304 ;
    skos:prefLabel "Psikyɛ"@fr ;
    skos:scopeNote "Langue tchadique (branche Biu-Mandara), environ 40 500 locuteurs en 1982."@fr .

lieu:bibemi a mv:Lieu ;
    skos:prefLabel "Bibemi"@fr ;
    schema:containedInPlace lieu:cameroun .

personne:goggo-addi a foaf:Person ;
    skos:prefLabel "Goggo Addi"@fr ;
    foaf:name "Goggo Addi" ;
    schema:birthDate "1911"^^xsd:gYear ;
    schema:birthPlace lieu:bibemi ;
    schema:deathDate "1999-11"^^xsd:gYearMonth ;
    schema:deathPlace lieu:garoua ;
    schema:jobTitle "Conteuse"@fr ;
    schema:knowsLanguage langue:fulfulde .

peuple:kapsiki a mv:Peuple ;
    dct:language langue:psikye ;
    dct:spatial lieu:monts-mandara ;
    skos:closeMatch wd:Q2437423 ;
    skos:prefLabel "Kapsiki"@fr .

peuple:mafa a mv:Peuple ;
    dct:relation site:diy-gid-biy ;
    skos:closeMatch wd:Q3276439 ;
    skos:prefLabel "Mafa"@fr ;
    skos:scopeNote "Présents depuis le XVe siècle, liés au site Diy-Gid-Biy."@fr .

site:lamidat-de-garoua a mv:Site ;
    dct:description "Chefferie traditionnelle peule."@fr ;
    dct:relation peuple:fulbe ;
    skos:prefLabel "Lamidat de Garoua"@fr ;
    schema:containedInPlace lieu:garoua .

lieu:cameroun a mv:Lieu ;
    owl:sameAs wd:Q1009 ;
    skos:prefLabel "Cameroun"@fr .

lieu:garoua a mv:Lieu ;
    owl:sameAs wd:Q157915 ;
    skos:prefLabel "Garoua"@fr ;
    schema:containedInPlace lieu:cameroun .

personne:ursula-baumgardt a foaf:Person ;
    skos:prefLabel "Ursula Baumgardt"@fr ;
    foaf:name "Ursula Baumgardt" ;
    schema:affiliation "INALCO ; CNRS" ;
    schema:jobTitle "Professeure d'université et chercheuse"@fr .

peuple:fulbe a mv:Peuple ;
    dct:language langue:fulfulde ;
    dct:relation site:lamidat-de-garoua ;
    skos:altLabel "Peuls"@fr ;
    skos:exactMatch wd:Q202575 ;
    skos:prefLabel "Fulbe"@fr ;
    skos:scopeNote "Élite islamisée, classe dirigeante du Nord."@fr .

site:diy-gid-biy a mv:Site ;
    mv:critereUnesco "iii" ;
    mv:inscritUnesco "2025-07"^^xsd:gYearMonth ;
    mv:siecleDebut 12 ;
    mv:siecleFin 17 ;
    dct:description "Ensemble de vestiges en pierre sèche."@fr ;
    owl:sameAs wd:Q5285004 ;
    skos:prefLabel "Diy-Gid-Biy"@fr ;
    schema:containedInPlace lieu:monts-mandara .

langue:fulfulde a mv:Langue ;
    skos:exactMatch wd:Q33454 ;
    skos:prefLabel "Fulfulde"@fr ;
    skos:scopeNote "Langue véhiculaire du Nord-Cameroun."@fr .

lieu:monts-mandara a mv:Lieu ;
    dct:description "Chaîne volcanique entre le Cameroun et le Nigeria."@fr ;
    owl:sameAs wd:Q1888885 ;
    skos:prefLabel "Monts Mandara"@fr .

