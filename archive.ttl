mv:Rituel a rdfs:Class ;
    rdfs:label "Rituel"@fr ;
    rdfs:subClassOf schema:Event .

mv:Site a rdfs:Class ;
    rdfs:label "Site patrimonial"@fr ;
    rdfs:subClassOf schema:Place .

collection:contes-goggo-addi a mv:RecueilDeContes,
        edm:ProvidedCHO ;
    mv:associeAuPeuple peuple:fulbe ;
    dct:contributor personne:ursula-baumgardt ;
    dct:creator personne:goggo-addi ;
    dct:language langue:fulfulde ;
    dct:temporal "1985/1989" ;
    skos:prefLabel "Contes de Goggo Addi"@fr ;
    prov:wasAttributedTo personne:ursula-baumgardt .

